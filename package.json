{
  "name": "stcr-redesign",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "production:preflight": "npm run backend:preflight",
    "db:migrate": "node scripts/migrate-database.mjs",
    "db:backup": "powershell -ExecutionPolicy Bypass -File ./scripts/backup-database.ps1",
    "db:secure": "powershell -ExecutionPolicy Bypass -File ./scripts/secure-test-database.ps1",
    "public:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-public-test.ps1",
    "public:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-public-test.ps1",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch backend/src/server.mjs",
    "start": "node backend/src/server.mjs",
    "backend:verify": "node backend/scripts/verify-migration.mjs",
    "backend:check": "node --check backend/src/server.mjs && node --check backend/src/http/app.mjs && node --check backend/src/http/security.mjs && node --check backend/src/runtime/readiness.mjs && node --check backend/src/runtime/function-runner.mjs && node --check backend/src/mqtt/mqtt-service.mjs && node backend/scripts/verify-migration.mjs && node backend/scripts/self-test.mjs && node backend/scripts/security-test.mjs",
    "backend:preflight": "node backend/scripts/preflight.mjs",
    "user:create": "node backend/tools/create-user.mjs",
    "api-key:create": "node backend/tools/create-api-key.mjs",
    "password:hash": "node backend/tools/hash-password.mjs",
    "backend:security-test": "node backend/scripts/security-test.mjs",
    "backend:smoke": "node backend/scripts/production-smoke.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "production:check": "npm run backend:check && npm run backend:preflight && npm run build && npm run backend:smoke && npm run audit:production"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "mqtt": "^5.15.2",
    "mysql2": "^3.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "express": "^5.1.0",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "concurrently": "^9.2.1",
    "@vitejs/plugin-react": "^6.0.4"
  },
  "overrides": {
    "dompurify": "^3.4.5",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "esbuild@0.28.1": true
  }
}
